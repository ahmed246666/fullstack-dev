datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  AGENT
  CUSTOMER
}

enum CustomerTier {
  STANDARD
  VIP
  ENTERPRISE
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketChannel {
  EMAIL
  WHATSAPP
  LIVE_CHAT
  SMS
  WEB_FORM
}

model User {
  id              String         @id @default(uuid())
  name            String
  nameAr          String?
  email           String         @unique
  role            String         @default("AGENT") // ADMIN, AGENT, CUSTOMER
  department      String?        // Support, Billing, Technical
  status          String         @default("ACTIVE") // ACTIVE, INACTIVE
  avatarUrl       String?
  assignedTickets Ticket[]       @relation("AssignedAgent")
  notes           Note[]         @relation("NoteAuthor")
  auditLogs       AuditLog[]     @relation("AuditActor")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Customer {
  id              String         @id @default(uuid())
  name            String
  nameAr          String?
  email           String         @unique
  phone           String?
  company         String?
  tier            String         @default("STANDARD") // STANDARD, VIP, ENTERPRISE
  avatarUrl       String?
  status          String         @default("ACTIVE") // ACTIVE, INACTIVE
  preferredLang   String         @default("en") // en, ar
  tickets         Ticket[]       @relation("CustomerTickets")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Ticket {
  id              String         @id @default(uuid())
  ticketNumber    String         @unique // e.g. TCK-1001
  title           String
  description     String
  status          String         @default("NEW") // NEW, OPEN, PENDING, RESOLVED, CLOSED
  priority        String         @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  channel         String         @default("WEB_FORM") // EMAIL, WHATSAPP, LIVE_CHAT, SMS, WEB_FORM
  category        String         @default("General") // Technical, Billing, General, Inquiries
  department      String         @default("Support") // Support, Billing, Technical
  
  // Relations
  customerId      String
  customer        Customer       @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  
  assignedAgentId String?
  assignedAgent   User?          @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  
  notes           Note[]         @relation("TicketNotes")
  
  // SLA & Timestamps
  responseDueAt   DateTime?
  resolutionDueAt DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  
  // Customer Feedback / CSAT
  csatRating      Int?           // 1 to 5 stars
  csatFeedback    String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Note {
  id              String         @id @default(uuid())
  ticketId        String
  ticket          Ticket         @relation("TicketNotes", fields: [ticketId], references: [id], onDelete: Cascade)
  
  authorId        String?
  author          User?          @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String
  
  content         String
  isInternal      Boolean        @default(false)
  channel         String?        // EMAIL, WHATSAPP, LIVE_CHAT, SMS, INTERNAL
  
  createdAt       DateTime       @default(now())
}

model SLAConfig {
  id                  String     @id @default(uuid())
  priority            String     @unique // LOW, MEDIUM, HIGH, URGENT
  responseTimeHours   Float      // e.g. 1.0 (1 hour for urgent)
  resolutionTimeHours Float      // e.g. 4.0 (4 hours for urgent)
  escalationRole      String     @default("ADMIN")
}

model KnowledgeArticle {
  id              String         @id @default(uuid())
  slug            String         @unique
  title           String
  titleAr         String?
  content         String
  contentAr       String?
  category        String         // Getting Started, Account & Billing, Troubleshooting, API & Integrations
  tags            String?        // Comma-separated tags
  helpfulVotes    Int            @default(0)
  unhelpfulVotes  Int            @default(0)
  isPublished     Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AuditLog {
  id              String         @id @default(uuid())
  actorId         String?
  actor           User?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName       String
  action          String         // CREATE_TICKET, UPDATE_STATUS, ASSIGN_AGENT, ADD_NOTE, UPDATE_CUSTOMER
  entity          String         // Ticket, Customer, User, SLAConfig
  entityId        String
  details         String?        // JSON or textual diff details
  createdAt       DateTime       @default(now())
}

model CannedResponse {
  id              String         @id @default(uuid())
  shortcut        String         @unique // e.g. /greeting, /resolve, /more-info
  title           String
  titleAr         String?
  content         String
  contentAr       String?
  category        String         @default("General") // Greetings, Troubleshooting, Billing, Closures
}
