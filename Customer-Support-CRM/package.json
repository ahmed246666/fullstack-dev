{
  "name": "customer-support-crm",
  "version": "1.0.0",
  "description": "AZM Squad Enterprise Customer Support CRM Platform",
  "scripts": {
    "dev": "npm run server:dev",
    "build": "npm run server:build && npm run client:build",
    "codegen": "cd client && npm run codegen",
    "client:install": "cd client && npm install",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "server:install": "cd server && npm install",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "server:test": "cd server && npm run test",
    "server:db:push": "cd server && npm run prisma:push",
    "server:db:generate": "cd server && npm run prisma:generate",
    "server:db:seed": "cd server && npm run prisma:seed",
    "server:db:verify": "cd server && npm run prisma:verify",
    "server:db:studio": "cd server && npx prisma studio",
    "jira:list": "node jira.js list",
    "jira:sprints": "node jira.js sprints",
    "jira:sprint:issues": "node jira.js sprint-issues 1",
    "squad:status": "npx squad-kit status",
    "squad:list": "npx squad-kit list",
    "squad:doctor": "npx squad-kit doctor",
    "lint": "npm --prefix client run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,md}": [
      "npx --yes prettier --write"
    ],
    "client/**/*.{js,ts,tsx}": [
      "npm --prefix client run lint"
    ]
  },
  "keywords": [
    "crm",
    "customer-support",
    "nextjs",
    "express",
    "prisma",
    "typescript",
    "openapi"
  ],
  "author": "AZM Squad",
  "license": "ISC",
  "dependencies": {
    "lucide-react": "^1.34.0"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2"
  }
}
